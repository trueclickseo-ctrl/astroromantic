RewriteEngine On

# 1. Force HTTPS and www.astroromantic.com domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.astroromantic\.com$ [NC]
RewriteRule ^(.*)$ https://www.astroromantic.com/$1 [R=301,L]

# 2. Prevent direct client access to /out/ directory (SEO canonicalization)
# Uses %{THE_REQUEST} so it ONLY matches external client requests, NEVER internal rewrites or mod_dir lookups
RewriteCond %{THE_REQUEST} \s/out/([^\s\?]*) [NC]
RewriteRule ^out/(.*)$ https://www.astroromantic.com/$1 [R=301,L]

# 3. Force trailing slashes on clean page/directory URLs (excluding files with extensions)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/out/$1 !-f
RewriteCond %{REQUEST_URI} !/[^/]+\.[^/]+$
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://www.astroromantic.com/$1/ [R=301,L]

# 4. Internal Rewrite: Route clean URLs to the static export in /out/
RewriteCond %{REQUEST_URI} !^/out/
RewriteRule ^(.*)$ /out/$1 [L]


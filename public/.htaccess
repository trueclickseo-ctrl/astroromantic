DirectoryIndex index.html out/index.html

RewriteEngine On

# 1. Explicit MIME Types
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
</IfModule>

# 2. Caching Headers for Static Assets & Next.js Chunks
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|gif|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 3. Force HTTPS and www.astroromantic.com domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\.astroromantic\.com$ [NC]
RewriteRule ^(.*)$ https://www.astroromantic.com/$1 [R=301,L]

# 4. Redirect legacy URLs to canonical targets
RewriteRule ^love-calculator/?$ https://www.astroromantic.com/love/love-calculator/ [R=301,L]
RewriteRule ^calculators/love-calculator/?$ https://www.astroromantic.com/love/love-calculator/ [R=301,L]
RewriteRule ^calculators/navamsa-chart/?$ https://www.astroromantic.com/d9-chart-calculator/ [R=301,L]

# 5. Serve existing files directly, or directories ONLY if root index.html exists
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# 6. Sub-folder Routing (when deployed inside public_html/out/ folder)
# Handle root homepage / -> out/index.html
RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{DOCUMENT_ROOT}/out/index.html -f
RewriteRule ^$ out/index.html [L]

# Handle static files in out/ (e.g. /_next/..., /images/..., /icon.svg)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/out/$1 -f
RewriteRule ^(.*)$ out/$1 [L]

# Handle page directory routes in out/ (e.g. /numerology/, /love/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/out/$1/index.html -f
RewriteRule ^(.*)$ out/$1/index.html [L]

# 7. Clean 404 Error Handling
ErrorDocument 404 /404.html
